#define ASSERT(EXP)                                                            \
  do {                                                                         \
    if (EXP) {                                                                 \
      printf("passed %s", #EXP);                                               \
    } else {                                                                   \
      printf("Error occurred at line: %d in %s ", __LINE__, __FILE__);         \
      printf("%s", #EXP);                                                      \
    }                                                                          \
  } while (0)

